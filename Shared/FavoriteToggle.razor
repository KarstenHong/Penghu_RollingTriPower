@inject FirebaseAuthService AuthService
@inject FirestoreService Firestore
@inject NavigationManager Nav

<button type="button" class="favorite-toggle @(IsFavorite ? "active" : "")" @onclick="Toggle" title="加入我的最愛">
    @(IsFavorite ? "★" : "☆")
</button>

@code {
    [Parameter]
    public string VenueId { get; set; } = "";

    private UserProfile? profile;
    private bool IsFavorite => profile?.FavoriteVenueIds.Contains(VenueId) == true;

    protected override async Task OnInitializedAsync()
    {
        var uid = AuthService.CurrentUser?.Uid;
        if (uid is not null)
        {
            profile = await Firestore.GetByIdAsync<UserProfile>("users", uid) ?? new UserProfile { Uid = uid };
        }
    }

    private async Task Toggle()
    {
        var uid = AuthService.CurrentUser?.Uid;
        if (uid is null)
        {
            Nav.NavigateTo("/member/login");
            return;
        }

        profile ??= new UserProfile { Uid = uid };
        if (!profile.FavoriteVenueIds.Remove(VenueId))
        {
            profile.FavoriteVenueIds.Add(VenueId);
        }

        await Firestore.SetAsync("users", uid, profile);
    }
}
