@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 font-size-controls">
            <span>字體大小：</span>
            <button @onclick='() => SetFontSize("")'>標準</button>
            <button @onclick='() => SetFontSize("text-large")'>大</button>
            <button @onclick='() => SetFontSize("text-xlarge")'>特大</button>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task SetFontSize(string cssClass)
    {
        await JS.InvokeVoidAsync("document.body.setAttribute", "class", cssClass);
    }
}
