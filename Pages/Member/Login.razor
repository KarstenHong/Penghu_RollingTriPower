@page "/member/login"
@inject FirebaseAuthService AuthService
@inject NavigationManager Nav

<PageTitle>會員登入</PageTitle>

<h1>會員登入</h1>

<EditForm Model="model" OnValidSubmit="HandleLogin" class="member-form">
    <label>
        電子郵件
        <InputText @bind-Value="model.Email" />
    </label>
    <label>
        密碼
        <InputText @bind-Value="model.Password" type="password" />
    </label>
    <button type="submit" class="primary-button">登入</button>
</EditForm>

@if (error is not null)
{
    <p class="error-text">登入失敗，請確認帳號密碼是否正確。</p>
}

<p>還沒有帳號嗎？<a href="/member/register">立即註冊</a></p>

@code {
    private readonly LoginModel model = new();
    private string? error;

    private async Task HandleLogin()
    {
        error = await AuthService.LoginAsync(model.Email, model.Password);
        if (error is null)
        {
            Nav.NavigateTo("/member/profile");
        }
    }

    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
