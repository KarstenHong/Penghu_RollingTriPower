@page "/member/favorites"
@attribute [Authorize]
@inject FirebaseAuthService AuthService
@inject FirestoreService Firestore

<PageTitle>我的最愛</PageTitle>

<h1>我的最愛</h1>

@if (loading)
{
    <p>載入中...</p>
}
else
{
    <h2>喜愛的運動</h2>
    @if (!profile!.FavoriteSports.Any())
    {
        <p class="hint-text">尚未選擇喜愛的運動，可到「會員資料」頁面設定。</p>
    }
    else
    {
        <div class="icon-grid">
            @foreach (var sportId in profile.FavoriteSports)
            {
                <div class="icon-button">
                    <img src="images/icons/@SportTypes.IconFileOf(sportId)" alt="@SportTypes.NameOf(sportId)" />
                    <span>@SportTypes.NameOf(sportId)</span>
                </div>
            }
        </div>
    }

    <h2>收藏的據點</h2>
    @if (!favoriteVenues.Any())
    {
        <p class="hint-text">尚未收藏任何據點，瀏覽「社區活動查詢」時可點選 ☆ 加入收藏。</p>
    }
    else
    {
        <div class="venue-list">
            @foreach (var venue in favoriteVenues)
            {
                <div class="venue-card">
                    <h3>@venue.Name <span class="venue-type">(@VenueTypes.NameOf(venue.Type))</span> <FavoriteToggle VenueId="@venue.Id" /></h3>
                    <p>鄉鎮：@Townships.NameOf(venue.Township)</p>
                    <p>地址：@venue.Address</p>
                    <p>電話：@venue.Phone</p>
                </div>
            }
        </div>
    }
}

@code {
    private UserProfile? profile;
    private List<Venue> favoriteVenues = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var uid = AuthService.CurrentUser?.Uid ?? "";
        profile = await Firestore.GetByIdAsync<UserProfile>("users", uid) ?? new UserProfile { Uid = uid };

        var allVenues = await Firestore.GetAllAsync<Venue>("venues");
        favoriteVenues = allVenues.Where(v => profile.FavoriteVenueIds.Contains(v.Id!)).ToList();

        loading = false;
    }
}
