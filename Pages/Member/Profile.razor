@page "/member/profile"
@attribute [Authorize]
@inject FirebaseAuthService AuthService
@inject FirestoreService Firestore

<PageTitle>會員資料</PageTitle>

<h1>我的會員資料</h1>

@if (loading)
{
    <p>載入中...</p>
}
else
{
    <EditForm Model="profile" OnValidSubmit="HandleSave" class="member-form">
        <label>
            姓名
            <InputText @bind-Value="profile!.Name" />
        </label>
        <label>
            出生年月日
            <InputDate @bind-Value="birthDate" />
        </label>
        <label>
            聯絡電話
            <InputText @bind-Value="profile!.Phone" />
        </label>
        <label>
            所在鄉鎮
            <InputSelect @bind-Value="profile!.Township">
                <option value="">請選擇</option>
                @foreach (var t in Townships.All)
                {
                    <option value="@t.Id">@t.Name</option>
                }
            </InputSelect>
        </label>

        <fieldset>
            <legend>喜愛的運動</legend>
            @foreach (var sport in SportTypes.All)
            {
                <label class="checkbox-line">
                    <input type="checkbox"
                           checked="@profile!.FavoriteSports.Contains(sport.Id)"
                           @onchange="e => ToggleSport(sport.Id, e.Value)" />
                    @sport.Name
                </label>
            }
        </fieldset>

        <button type="submit" class="primary-button">儲存</button>
    </EditForm>

    @if (saved)
    {
        <p class="success-text">已儲存！</p>
    }

    <button type="button" class="secondary-button" @onclick="HandleLogout">登出</button>
}

@code {
    private UserProfile? profile;
    private DateTime? birthDate;
    private bool loading = true;
    private bool saved;
    private string uid = "";

    protected override async Task OnInitializedAsync()
    {
        uid = AuthService.CurrentUser?.Uid ?? "";
        profile = await Firestore.GetByIdAsync<UserProfile>("users", uid) ?? new UserProfile { Uid = uid };
        birthDate = DateTime.TryParse(profile.BirthDate, out var d) ? d : null;
        loading = false;
    }

    private void ToggleSport(string sportId, object? isChecked)
    {
        if (isChecked is true)
        {
            if (!profile!.FavoriteSports.Contains(sportId))
            {
                profile.FavoriteSports.Add(sportId);
            }
        }
        else
        {
            profile!.FavoriteSports.Remove(sportId);
        }
    }

    private async Task HandleSave()
    {
        profile!.BirthDate = birthDate?.ToString("yyyy-MM-dd") ?? "";
        await Firestore.SetAsync("users", uid, profile);
        saved = true;
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
    }
}
