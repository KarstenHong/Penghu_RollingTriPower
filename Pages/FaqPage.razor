@page "/faq"
@inject FirestoreService Firestore

<PageTitle>常見問題</PageTitle>

<h1>常見問題</h1>

@if (loading)
{
    <p>載入中...</p>
}
else if (!faqs.Any())
{
    <p class="hint-text">目前沒有常見問題資料。</p>
}
else
{
    <div class="faq-list">
        @foreach (var faq in faqs)
        {
            <details class="faq-item">
                <summary>@faq.Question</summary>
                <p>@faq.Answer</p>
            </details>
        }
    </div>
}

@code {
    private List<Faq> faqs = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        faqs = await Firestore.GetAllAsync<Faq>("faq");
        loading = false;
    }
}
