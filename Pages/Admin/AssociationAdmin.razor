@page "/admin/associations"
@attribute [Authorize(Roles = "admin")]
@inject FirestoreService Firestore

<PageTitle>社區協會聯絡資訊管理</PageTitle>

<a href="/admin" class="back-button">&larr; 返回後台首頁</a>
<h1>社區協會聯絡資訊管理</h1>

@if (loading)
{
    <p>載入中...</p>
}
else
{
    <table class="admin-table">
        <thead>
            <tr><th>名稱</th><th>鄉鎮</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var a in associations)
            {
                <tr>
                    <td>@a.Name</td>
                    <td>@Townships.NameOf(a.Township)</td>
                    <td>
                        <button @onclick="() => Edit(a)">編輯</button>
                        <button @onclick="() => Delete(a)">刪除</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button class="primary-button" @onclick="NewAssociation">+ 新增協會</button>

    @if (editing is not null)
    {
        <EditForm Model="editing" OnValidSubmit="Save" class="member-form">
            <label>名稱 <InputText @bind-Value="editing.Name" /></label>
            <label>
                鄉鎮
                <InputSelect @bind-Value="editing.Township">
                    <option value="">請選擇</option>
                    @foreach (var t in Townships.All)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </InputSelect>
            </label>
            <label>電話 <InputText @bind-Value="editing.Phone" /></label>
            <label>地址 <InputText @bind-Value="editing.Address" /></label>

            <button type="submit" class="primary-button">儲存</button>
            <button type="button" class="secondary-button" @onclick="() => editing = null">取消</button>
        </EditForm>
    }
}

@code {
    private List<Association> associations = new();
    private Association? editing;
    private bool loading = true;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        loading = true;
        associations = await Firestore.GetAllAsync<Association>("associations");
        loading = false;
    }

    private void NewAssociation() => editing = new Association();

    private void Edit(Association a) => editing = new Association
    {
        Id = a.Id,
        Township = a.Township,
        Name = a.Name,
        Phone = a.Phone,
        Address = a.Address,
    };

    private async Task Save()
    {
        if (editing!.Id is null)
        {
            await Firestore.AddAsync("associations", editing);
        }
        else
        {
            await Firestore.SetAsync("associations", editing.Id, editing);
        }
        editing = null;
        await Reload();
    }

    private async Task Delete(Association a)
    {
        if (a.Id is not null)
        {
            await Firestore.DeleteAsync("associations", a.Id);
            await Reload();
        }
    }
}
