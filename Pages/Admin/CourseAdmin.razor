@page "/admin/courses"
@attribute [Authorize(Roles = "admin")]
@inject FirestoreService Firestore

<PageTitle>運動課程管理</PageTitle>

<a href="/admin" class="back-button">&larr; 返回後台首頁</a>
<h1>運動課程管理</h1>

@if (loading)
{
    <p>載入中...</p>
}
else
{
    <table class="admin-table">
        <thead>
            <tr><th>場域</th><th>運動類型</th><th>時間</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var c in courses)
            {
                <tr>
                    <td>@VenueName(c.VenueId)</td>
                    <td>@SportTypes.NameOf(c.SportType)</td>
                    <td>@c.Schedule</td>
                    <td>
                        <button @onclick="() => Edit(c)">編輯</button>
                        <button @onclick="() => Delete(c)">刪除</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button class="primary-button" @onclick="NewCourse">+ 新增課程</button>

    @if (editing is not null)
    {
        <EditForm Model="editing" OnValidSubmit="Save" class="member-form">
            <label>
                場域
                <InputSelect @bind-Value="editing.VenueId">
                    <option value="">請選擇</option>
                    @foreach (var v in venues)
                    {
                        <option value="@v.Id">@v.Name</option>
                    }
                </InputSelect>
            </label>
            <label>
                運動類型
                <InputSelect @bind-Value="editing.SportType">
                    <option value="">請選擇</option>
                    @foreach (var s in SportTypes.All)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </InputSelect>
            </label>
            <label>上課時間 <InputText @bind-Value="editing.Schedule" placeholder="例如：每週二、四 09:00-10:00" /></label>
            <label>說明 <InputTextArea @bind-Value="editing.Description" /></label>

            <button type="submit" class="primary-button">儲存</button>
            <button type="button" class="secondary-button" @onclick="() => editing = null">取消</button>
        </EditForm>
    }
}

@code {
    private List<Course> courses = new();
    private List<Venue> venues = new();
    private Course? editing;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        venues = await Firestore.GetAllAsync<Venue>("venues");
        await Reload();
    }

    private async Task Reload()
    {
        loading = true;
        courses = await Firestore.GetAllAsync<Course>("courses");
        loading = false;
    }

    private string VenueName(string venueId) => venues.FirstOrDefault(v => v.Id == venueId)?.Name ?? venueId;

    private void NewCourse() => editing = new Course();

    private void Edit(Course c) => editing = new Course
    {
        Id = c.Id,
        VenueId = c.VenueId,
        SportType = c.SportType,
        Schedule = c.Schedule,
        Description = c.Description,
        IconKey = c.IconKey,
    };

    private async Task Save()
    {
        editing!.IconKey = editing.SportType;
        if (editing.Id is null)
        {
            await Firestore.AddAsync("courses", editing);
        }
        else
        {
            await Firestore.SetAsync("courses", editing.Id, editing);
        }
        editing = null;
        await Reload();
    }

    private async Task Delete(Course c)
    {
        if (c.Id is not null)
        {
            await Firestore.DeleteAsync("courses", c.Id);
            await Reload();
        }
    }
}
