@page "/admin/posts"
@attribute [Authorize(Roles = "admin")]
@inject FirestoreService Firestore

<PageTitle>公告管理</PageTitle>

<a href="/admin" class="back-button">&larr; 返回後台首頁</a>
<h1>最新消息／活動資訊管理</h1>

@if (loading)
{
    <p>載入中...</p>
}
else
{
    <table class="admin-table">
        <thead>
            <tr><th>分類</th><th>標題</th><th>日期</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var p in posts)
            {
                <tr>
                    <td>@(p.Category == "event" ? "活動資訊" : "最新消息")</td>
                    <td>@p.Title</td>
                    <td>@p.Date</td>
                    <td>
                        <button @onclick="() => Edit(p)">編輯</button>
                        <button @onclick="() => Delete(p)">刪除</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button class="primary-button" @onclick="NewPost">+ 新增公告</button>

    @if (editing is not null)
    {
        <EditForm Model="editing" OnValidSubmit="Save" class="member-form">
            <label>
                分類
                <InputSelect @bind-Value="editing.Category">
                    <option value="news">最新消息</option>
                    <option value="event">活動資訊</option>
                </InputSelect>
            </label>
            <label>標題 <InputText @bind-Value="editing.Title" /></label>
            <label>日期 <InputDate @bind-Value="postDate" /></label>
            <label>內容 <InputTextArea @bind-Value="editing.Content" /></label>
            <label>圖片網址（選填） <InputText @bind-Value="editing.ImageUrl" /></label>

            <button type="submit" class="primary-button">儲存</button>
            <button type="button" class="secondary-button" @onclick="() => editing = null">取消</button>
        </EditForm>
    }
}

@code {
    private List<Post> posts = new();
    private Post? editing;
    private DateTime? postDate;
    private bool loading = true;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        loading = true;
        posts = await Firestore.GetAllAsync<Post>("posts");
        loading = false;
    }

    private void NewPost()
    {
        editing = new Post();
        postDate = DateTime.Today;
    }

    private void Edit(Post p)
    {
        editing = new Post
        {
            Id = p.Id,
            Category = p.Category,
            Title = p.Title,
            Content = p.Content,
            Date = p.Date,
            ImageUrl = p.ImageUrl,
        };
        postDate = DateTime.TryParse(p.Date, out var d) ? d : DateTime.Today;
    }

    private async Task Save()
    {
        editing!.Date = postDate?.ToString("yyyy-MM-dd") ?? "";
        if (editing.Id is null)
        {
            await Firestore.AddAsync("posts", editing);
        }
        else
        {
            await Firestore.SetAsync("posts", editing.Id, editing);
        }
        editing = null;
        await Reload();
    }

    private async Task Delete(Post p)
    {
        if (p.Id is not null)
        {
            await Firestore.DeleteAsync("posts", p.Id);
            await Reload();
        }
    }
}
